# main.py 실행 전, 이 파일을 .env로 복사하고 실제 값을 채운 뒤 서버 환경변수로 로드하세요.
# .env 파일 자체는 절대 git에 커밋하지 마세요 (.gitignore에 이미 추가됨).

# 필수 - OpenAI Whisper STT용 API 키
OPENAI_API_KEY=

# 필수 - NAVER CLOVA OCR
NAVER_OCR_URL=
NAVER_SECRET_KEY=

# 선택 - 그 외 CONFIG 항목(STREAM_URL, RTSP_OUTPUT_URL 등)은
# main.py에 이미 안전한 기본값이 있어 필요할 때만 설정하면 됩니다.
